# Copy to .env and fill in. Never commit the real .env.

# ---- Database (PostgreSQL, e.g. Supabase) ----
# Pooled connection (transaction mode, pgbouncer) used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (session mode) used by Prisma for schema changes.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Percent-encode special characters in the password (* -> %2A, @ -> %40, # -> %23).

# ---- Security ----
# Random string of at least 32 characters:  openssl rand -base64 48
AUTH_SECRET=""
# Any random string. Entered once on /setup to create the first admin account.
SETUP_TOKEN=""

# Public HTTPS address of this deployment, e.g. https://calls.yourcompany.com
APP_URL=""

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ---- Recording storage ----
# Supabase secret key (sb_secret_...) to store recordings in a private bucket.
# Required on serverless hosts. Leave empty to store recordings on local disk.
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="call-recordings"
RECORDINGS_DIR="storage/recordings"
MAX_UPLOAD_MB="50"

# ---- AI ----
OPENAI_API_KEY=""
OPENAI_TRANSCRIBE_MODEL="whisper-1"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
