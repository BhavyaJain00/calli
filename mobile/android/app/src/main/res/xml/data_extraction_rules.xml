<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the device token out of cloud backups and phone-to-phone transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
